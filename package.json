{
  "name": "shuoyu-me",
  "private": true,
  "workspaces": [
    "blog"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:blog": "npm run dev --workspace blog",
    "test": "vitest run",
    "test:all": "npm test && npm test --workspace blog",
    "check": "astro check",
    "check:all": "npm run check && npm run check --workspace blog",
    "build": "astro check && astro build",
    "build:blog": "npm run build --workspace blog",
    "build:all": "npm run build && npm run build:blog",
    "verify:blog-build": "node scripts/verify-blog-build.mjs",
    "corl2024:bootstrap": "node scripts/corl2024/bootstrap.mjs",
    "corl2024:inspect": "node scripts/corl2024/inspect.mjs",
    "corl2024:validate": "node scripts/corl2024/validate.mjs",
    "corl2024:summary": "node scripts/corl2024/summary.mjs",
    "preview": "astro preview",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "astro": "^7.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cheerio": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
