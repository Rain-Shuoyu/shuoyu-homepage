---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  bilingual?: boolean;
}

const { headings, bilingual = false } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth <= 3);
const splitAt = bilingual && visibleHeadings.length % 2 === 0
  ? visibleHeadings.length / 2
  : 0;
const entries = visibleHeadings.map((heading, index) => ({
  heading,
  language: splitAt > 0 ? (index < splitAt ? 'en' : 'zh') : undefined,
}));
---

{entries.length > 0 && (
  <details class="table-of-contents">
    <summary class="table-of-contents-summary" aria-label="On this page" data-i18n-aria-label="tableOfContents">
      <span class="page-kicker table-of-contents-label" data-i18n-key="tableOfContents">On this page</span>
    </summary>
    <ol>
      {entries.map(({ heading, language }) => (
        <li
          class={'toc-depth-' + heading.depth}
          data-content-language={language}
          hidden={language === 'zh'}
        >
          <a href={'#' + heading.slug}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}
