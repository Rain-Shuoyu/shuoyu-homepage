---
import '../styles/global.css';
import Toast from '../components/Toast.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /* Keeps placeholder pages out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site ?? new URL('https://shuoyu.me');
const canonicalUrl = canonical.toString();
/* One shared card for every page, resolved against the site origin so
   the value is absolute even on nested routes. */
const ogImageUrl = new URL('/og.png', canonical).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Without these the fonts are only discovered once the stylesheet
        has parsed, which delays the swap and lengthens the flash of
        fallback text. Both faces are used above the fold — the serif in
        the name, Inter in everything else — so both are worth
        preloading. crossorigin is required on font preloads even
        same-origin, or the fetch is made twice. */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <meta property="og:site_name" content="Shuoyu Chen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {/* Absolute URL: scrapers do not resolve relative paths. */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.description}`} />
    {/* large_image rather than summary, now that a 1200x630 card exists. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Toast />
    <slot />

  </body>
</html>
