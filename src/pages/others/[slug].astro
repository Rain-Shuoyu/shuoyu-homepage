---
import ProjectPage from '../../components/ProjectPage.astro';
import { otherProjects, type Project } from '../../data/projects';

/* Only side projects that actually have a write-up get a page. Without
   this filter the others would build as empty shells, and OthersList would
   link inward to a page with nothing on it. */
export function getStaticPaths() {
  return otherProjects
    .filter((project) => project.detail?.intro?.length)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<ProjectPage project={project} backHref="/#others" backLabel="All projects" />
