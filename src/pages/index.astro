---
import SiteLayout from '../layouts/SiteLayout.astro';
import SideIdentity from '../components/SideIdentity.astro';
import NowSection from '../components/NowSection.astro';
import ProjectList from '../components/ProjectList.astro';
import AboutSection from '../components/AboutSection.astro';
import { site } from '../data/site';
import { labProjects, researchProjects } from '../data/projects';
---

<SiteLayout title={site.name + ' — Researcher & Builder'} description={site.description}>
  <div class="page">
    <SideIdentity />
    <main class="content">
      <NowSection />
      <ProjectList heading="Research" projects={researchProjects} />
      <ProjectList heading="Lab" projects={labProjects} />
      <AboutSection />
    </main>
  </div>
</SiteLayout>
