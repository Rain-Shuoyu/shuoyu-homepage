---
import { site } from '../data/site';

interface Props {
  /* Hidden on the changelog page itself, which already has a back link. */
  showChangelogLink?: boolean;
}

const { showChangelogLink = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-meta">
    <span>&copy; {year} {site.name}</span>
    <span aria-hidden="true">·</span>
    <span>{site.location}</span>
  </div>

  {showChangelogLink && (
    <a class="footer-link" href="/changelog">Log</a>
  )}
</footer>
