---
import { site } from '../data/site';
import ExternalLink from './ExternalLink.astro';
import CopyEmail from './CopyEmail.astro';
import SectionNav from './SectionNav.astro';

const nameParts = site.name.split(' ');
---

<aside
  class="identity glass glass-strong"
  aria-labelledby="identity-heading"
>
  <div>
    {/* Purely a rule above the name — the handle text it used to carry
        just restated the heading below it. */}
    <p class="identity-eyebrow" aria-hidden="true"></p>

    <h1 class="identity-name" id="identity-heading">
      {nameParts.map((part) => <span>{part}</span>)}
    </h1>

    <div class="identity-meta">
      <p class="role">{site.role}</p>
      <p>{site.affiliation}</p>
      <p>{site.location}</p>
    </div>

    <p class="identity-bio">{site.description}</p>
  </div>

  <div class="identity-links">
    <ExternalLink href={site.cv} label="CV" />
    <ExternalLink href={site.github} label="GitHub" />
    <CopyEmail />
  </div>

  <SectionNav />

</aside>
