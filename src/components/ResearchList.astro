---
import type { Project } from '../data/projects';
import SectionHeader from './SectionHeader.astro';
import LinkIcon from './LinkIcon.astro';
import { iconForLink } from '../lib/link-icon';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

/* A 4-digit year means a real venue (e.g. "ICRA 2026") and earns the
   amber badge; descriptive labels stay plain. */
const isVenue = (meta: string) => /\b(19|20)\d{2}\b/.test(meta);
const selfName = 'Shuoyu Chen';

const roleLabel = (project: Project) => {
  const author = project.detail?.authors?.find((item) => item.name === selfName);
  return author?.roles?.includes('first') ? 'Co-first author' : 'Research contributor';
};

const cardLinks = (project: Project) => [
  { label: 'Project', href: project.href },
  ...(project.detail?.links ?? []),
];
---

<section id="research" class="reveal" aria-labelledby="research-heading">
  <SectionHeader
    title="Selected work"
    headingId="research-heading"
    tone="lead"
  />

  <ul class="research-list">
    {projects.map((project, i) => (
      <li>
        <article
          class:list={['research-card', { 'research-card-no-image': !project.detail?.media || (project.detail.media.kind === 'video' && !project.detail.media.poster) }]}
          style={`--row-index:${i}`}
        >
          {project.detail?.media && (project.detail.media.kind === 'image' || project.detail.media.poster) && (
            <a class="research-image-link" href={`/research/${project.slug}`} aria-label={`View ${project.name} details`}>
              <img
                class="research-image"
                src={project.detail.media.kind === 'image' ? project.detail.media.src : project.detail.media.poster}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="research-content">
            <div class="research-head">
              <span class="research-number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="research-title" id={`research-${project.slug}`}>
                <a href={`/research/${project.slug}`}>
                  <span class="research-title-text">{project.name}</span>
                </a>
              </h3>
            </div>

            <div class="research-side">
              <span class:list={['research-venue', { 'is-plain': !isVenue(project.meta) }]}>
                {project.meta}
              </span>
              {/* Rightward, not diagonal: this navigates within the site. */}
              <span class="research-arrow" aria-hidden="true">→</span>
            </div>

            <p class="research-desc">{project.description}</p>

            <div class="research-detail-row">
              <span class="research-role">{roleLabel(project)}</span>
              <div class="research-actions" aria-label={`${project.name} links`}>
                <a class="research-details-link" href={`/research/${project.slug}`}>
                  Details <span aria-hidden="true">→</span>
                </a>
                {cardLinks(project).map((link) => (
                  <a
                    class="research-action"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <LinkIcon name={iconForLink(link)} />
                    {link.label}
                  </a>
                ))}
              </div>
            </div>

            <ul class="research-tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
