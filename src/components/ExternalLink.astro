---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const isHttpLink = /^https?:\/\//.test(href);
---

<a
  class="link-pill glass"
  href={href}
  target={isHttpLink ? '_blank' : undefined}
  rel={isHttpLink ? 'noopener noreferrer' : undefined}
>
  {label}
  {/* Outbound arrow only for real outbound links, not mailto:. */}
  {isHttpLink && <span class="arrow" aria-hidden="true">↗</span>}
</a>
