---
import type { Project } from '../data/projects';
import SectionHeader from './SectionHeader.astro';

interface Props {
  projects: Project[];
  /* Show only the first N. Data is left intact — slicing happens
     here so the full list stays available (and tested). */
  limit?: number;
}

const { projects, limit = 3 } = Astro.props;
const shown = projects.slice(0, limit);
---

{/* No glass here on purpose: these rows stay flat hairlines so the
    research cards above them keep all the material weight. */}
<section id="others" class="reveal is-quiet" aria-labelledby="others-heading">
  <SectionHeader
    index="03"
    kicker="Others"
    title="Side projects"
    headingId="others-heading"
    tone="quiet"
  />

  <ul class="lab-list">
    {shown.map((project, i) => {
      /* Inward to the write-up when there is one, otherwise straight
         out to the repo — /others/<slug> only exists for projects with
         an intro, so linking inward without one would 404. */
      const hasPage = Boolean(project.detail?.intro?.length);
      const href = hasPage ? `/others/${project.slug}` : project.href;

      return (
        <li>
          <a
            class="lab-row"
            href={href}
            target={hasPage ? undefined : '_blank'}
            rel={hasPage ? undefined : 'noopener noreferrer'}
            aria-labelledby={`lab-${project.slug}`}
          >
            <span class="lab-number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <h3 class="lab-name" id={`lab-${project.slug}`}>{project.name}</h3>

            <span class="lab-meta">{project.meta}</span>
            <p class="lab-desc">{project.description}</p>
          </a>
        </li>
      );
    })}
  </ul>
</section>
