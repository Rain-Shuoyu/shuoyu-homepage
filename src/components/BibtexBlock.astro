---
interface Props {
  bibtex: string;
}

const { bibtex } = Astro.props;
---

{/* Always visible and deliberately plain — no glass, no disclosure.
    A citation is something a reader scans and copies, so hiding it
    behind a click and dressing it in material both got in the way. */}
<section class="bibtex" aria-labelledby="bibtex-heading">
  <div class="bibtex-head">
    <h3 class="bibtex-label" id="bibtex-heading">BibTeX</h3>
    <button class="bibtex-copy" type="button" data-bibtex-copy>Copy</button>
  </div>

  {/* Pre-formatted: the entry's own line breaks and indentation matter. */}
  <pre class="bibtex-code"><code>{bibtex}</code></pre>
</section>

<script>
  /* Reuses the document-level toast mounted by SiteLayout. */
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let timer: number | undefined;

  const flash = (message: string, ok: boolean) => {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.toggle('is-error', !ok);
    /* Reflow between removing and re-adding, so a second copy replays
       the transition instead of doing nothing. */
    toast.classList.remove('is-visible');
    void toast.offsetWidth;
    toast.classList.add('is-visible');

    clearTimeout(timer);
    timer = window.setTimeout(() => {
      toast.classList.remove('is-visible');
    }, 1800);
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-bibtex-copy]')) {
    button.addEventListener('click', async () => {
      const block = button.closest('.bibtex');
      const code = block?.querySelector('code')?.textContent;
      if (!code) return;

      /* navigator.clipboard needs a secure context, so it is absent over
         plain HTTP and in some in-app browsers. */
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(code);
          flash('Citation copied', true);
          return;
        } catch {
          /* Fall through to selecting the text instead. */
        }
      }

      /* Select the entry so the manual shortcut works. */
      const pre = block?.querySelector('pre');
      if (pre) {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const selection = getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      flash('Press ⌘C to copy', false);
    });
  }
</script>
