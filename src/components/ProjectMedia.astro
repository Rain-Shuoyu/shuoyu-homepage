---
import type { ProjectMedia } from '../data/projects';

interface Props {
  media: ProjectMedia;
}

const { media } = Astro.props;
const ratio = `${media.width} / ${media.height}`;
---

<figure class="project-media glass" style={`--media-ratio:${ratio}`}>
  {media.kind === 'video' ? (
    /* preload="none" plus poster: nothing downloads until the clip
       scrolls into view, so a page visit does not pull megabytes for a
       video the reader may never reach. The script below starts it.

       Muted and inline so autoplay is permitted at all, but autoplay is
       set by script rather than markup so prefers-reduced-motion can
       suppress it. Controls stay available either way. */
    <video
      class="project-media-el"
      src={media.src}
      poster={media.poster}
      width={media.width}
      height={media.height}
      muted
      loop
      playsinline
      controls
      preload="none"
      aria-label={media.alt}
      data-teaser
    ></video>
  ) : (
    <img
      class="project-media-el"
      src={media.src}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading="lazy"
      decoding="async"
    />
  )}
</figure>

<script>
  const teasers = document.querySelectorAll<HTMLVideoElement>('[data-teaser]');

  if (teasers.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Reduced motion: leave the poster and controls, download nothing. */
    if (!reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;

            if (!entry.isIntersecting) {
              /* Offscreen: stop decoding rather than looping unseen. */
              if (!video.paused) video.pause();
              continue;
            }

            video.preload = 'auto';
            video.play().catch(() => {
              /* Blocked by a browser or power-saving policy; the poster
                 and controls are already in place, so nothing to do. */
            });
          }
        },
        { threshold: 0.25 },
      );

      teasers.forEach((video) => io.observe(video));
    }
  }
</script>
