---
interface Props {
  title: string;
  headingId: string;
  /* 'lead' for the section the page is about; 'quiet' for the tail. */
  tone?: 'lead' | 'base' | 'quiet';
}

const { title, headingId, tone = 'base' } = Astro.props;
---

<div
  class:list={[
    'section-header',
    { 'is-lead': tone === 'lead', 'is-quiet': tone === 'quiet' },
  ]}
>
  <h2 class="section-title" id={headingId}>{title}</h2>
</div>
